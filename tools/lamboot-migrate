#!/bin/bash
# lamboot-migrate — BIOS→UEFI migration and cross-bootloader migration.
#
# The first automated end-to-end BIOS→UEFI migration tool for Linux.
# Handles: MBR→GPT conversion, ESP creation, bootloader installation,
# fstab rewrite, UEFI boot entry creation, verification, and rollback.
#
# Subcommands:
#   to-uefi [OPTIONS]    Convert BIOS/MBR system to UEFI/GPT (10-phase pipeline)
#   to-lamboot [OPTIONS] Migrate UEFI system from competing bootloader to LamBoot
#   verify [OPTIONS]     Run 11-check post-conversion verification
#   rollback [OPTIONS]   Revert the most recent to-uefi run using backup dir
#   status               Show current boot configuration
#
# Governed by ~/lamboot-dev/docs/specs/SPEC-LAMBOOT-MIGRATE.md (SDS-7).
# Part of the lamboot-tools suite; see SPEC-LAMBOOT-TOOLKIT-V1.md §3.1.

# shellcheck source=../lib/lamboot-toolkit-lib.sh
source "${LAMBOOT_LIB_DIR:-/usr/lib/lamboot-tools}/lamboot-toolkit-lib.sh"
# shellcheck source=../lib/lamboot-toolkit-help.sh
source "${LAMBOOT_LIB_DIR:-/usr/lib/lamboot-tools}/lamboot-toolkit-help.sh"

LAMBOOT_TOOL_NAME="lamboot-migrate"
LAMBOOT_TOOL_VERSION="0.7.3"

# ── Tool-specific options ────────────────────────────────────────────────
OPT_SUBCOMMAND=""
OPT_DISK=""
OPT_ESP_SIZE_MB=550
OPT_BOOTLOADER="grub-efi"
OPT_CMDLINE=""
OPT_BACKUP_DIR=""
OPT_METHOD="auto"
OPT_SKIP_VERIFY=0
OPT_KEEP_LEGACY_MBR=1
OPT_PRESERVE_GRUB=1
OPT_REMOVE_GRUB=0
OPT_UNSIGNED=0                # to-lamboot: skip --signed (Secure Boot OFF testing)
OPT_VERIFY_ALL=0
OPT_CAPCHECK_GATE=0           # opt-in capcheck readiness audit in preflight
OPT_VERIFY_PATH=""

# ── Phase 1 → Phase 5 shrink handoff (SDS-7 §3 Phase 5 shrink-to-make-room) ──
# Phase 1's guard_disk_free_space sets these when it determines the last
# partition must be shrunk to free space for the ESP. Phase 5 reads them to
# perform the actual resize2fs + sgdisk delete/recreate. Empty = no shrink.
LAMBOOT_NEEDS_SHRINK=0
LAMBOOT_SHRINK_LAST_PART_NUM=""
LAMBOOT_SHRINK_LAST_PART_DEV=""
LAMBOOT_SHRINK_NEW_PART_MB=""
LAMBOOT_SHRINK_DONE=0           # set to 1 by Phase 3b after shrink completes

# ── Method B chroot orchestration (SDS-7 §4.2 — runs under live ISO) ──
# Method B converts a target disk while booted from live media. Phase 5b mounts
# the target's (shrunken) root + the new ESP under LAMBOOT_TARGET_ROOT so that
# Phases 6-10 operate on the *target's* /etc/fstab, /boot, /boot/efi rather
# than the live ISO's. Method A leaves LAMBOOT_TARGET_ROOT empty so the
# helpers degrade to identity / no-op.
LAMBOOT_TARGET_ROOT=""
LAMBOOT_TARGET_BINDS=()
# Separate target filesystems (a dedicated /boot, /usr, … declared in the
# target's fstab) mounted under LAMBOOT_TARGET_ROOT in Phase 5b, shallow→deep.
# Without these the chroot's /boot is an empty mountpoint and grub-mkconfig
# emits a kernel-less grub.cfg (SDS-7 separate-/boot defect — see archie).
LAMBOOT_TARGET_FS_MOUNTS=()

# ── Inter-phase return-value globals ─────────────────────────────────────
# Bash function "returns" via stdout (`$(...)` capture) get corrupted when
# the function also invokes external commands that write to stdout. Use
# named globals instead for inter-phase data passing.
LAMBOOT_PHASE5_ESP_DEV=""

# ── Help registry (§10, three-surface rendering) ─────────────────────────
